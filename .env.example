# --- Docker Compose ---
# Host port for SurrealDB (change if 8000 is taken; update SURREAL_URL to match)
SURREAL_HOST_PORT=8000

# --- API (apps/api) ---
PORT=3001
SURREAL_URL=ws://127.0.0.1:8000/rpc
SURREAL_NS=haven
SURREAL_DB=haven
SURREAL_USER=root
SURREAL_PASS=root
# Demo-only secret. Generate a fresh one for anything beyond local use: openssl rand -hex 32
JWT_SECRET=dev-only-haven-jwt-secret-change-me-0123456789
EVIDENCE_DIR=./.data/evidence
EVIDENCE_MAX_BYTES=104857600
AI_RECOMMENDATION_MODE=local
WEB_ORIGIN=http://127.0.0.1:3000
# Peers allowed to set X-Forwarded-For (the login rate limit keys on client IP)
TRUST_PROXY=loopback

# --- Web (apps/web) ---
HAVEN_API_URL=http://127.0.0.1:3001/api/v1
# Forward the visitor's X-Forwarded-For to the API on sign-in. Enable only behind a reverse proxy
# that overwrites the header; otherwise visitors could spoof it to dodge the login rate limit.
HAVEN_TRUST_FORWARDED_FOR=false

# --- Mobile: Expo reads apps/mobile/.env, not this file. See README → Mobile. ---
