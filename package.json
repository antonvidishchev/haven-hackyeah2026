{
  "name": "haven",
  "private": true,
  "description": "Haven — safe, low-barrier reporting of social-safety incidents in Kraków (HackYeah 2026).",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "build": "pnpm -r build",
    "dev": "pnpm build:packages && concurrently -k -n shared,client,api,web -c gray,gray,cyan,green \"pnpm --filter @haven/shared dev\" \"pnpm --filter @haven/api-client dev\" \"pnpm --filter @haven/api dev\" \"pnpm --filter @haven/web dev\"",
    "mobile": "pnpm build:packages && pnpm --filter @haven/mobile start",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm build:packages && pnpm -r test",
    "e2e": "pnpm --filter @haven/web e2e",
    "format": "prettier --write .",
    "db:up": "docker compose up -d --wait surrealdb",
    "db:down": "docker compose down",
    "db:migrate": "pnpm build:packages && pnpm --filter @haven/api db:migrate",
    "db:seed": "pnpm build:packages && pnpm --filter @haven/api db:seed",
    "db:reset": "pnpm build:packages && pnpm --filter @haven/api db:reset",
    "demo:up": "docker compose --profile full up --build",
    "demo:down": "docker compose --profile full down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "globals": "^17.0.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
