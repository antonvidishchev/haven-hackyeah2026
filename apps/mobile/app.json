{
  "expo": {
    "name": "Haven",
    "slug": "haven",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "haven",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#285f4e",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 200,
          "backgroundColor": "#f5f6f1",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#131e1a"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Haven uses your location only when you tap “Use current location” to place a pin on your report."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Haven lets you attach photos and videos you choose to your report.",
          "cameraPermission": "Haven uses the camera when you take a photo or record video for your report.",
          "microphonePermission": "Haven records sound with videos you choose to record."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Haven uses the camera when you record video evidence.",
          "microphonePermission": "Haven records sound with the video you choose to record.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Haven uses the microphone when you choose to record audio evidence."
        }
      ],
      "expo-image",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#f5f6f1"
  }
}
